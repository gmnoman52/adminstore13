{
  "name": "united-super-store",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "2.119.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "firebase": "13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "10.14.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:web": "node ../scripts/check-env.mjs mobile && expo export --platform web --max-workers 2 && node ../scripts/check-build.mjs mobile",
    "build:android": "node ../scripts/check-env.mjs mobile && expo export --platform android --output-dir dist-android --max-workers 2",
    "preview:web": "node ../scripts/serve-built.mjs mobile",
    "prestart": "node ../scripts/check-env.mjs mobile",
    "preweb": "node ../scripts/check-env.mjs mobile",
    "preandroid": "node ../scripts/check-env.mjs mobile",
    "preios": "node ../scripts/check-env.mjs mobile"
  },
  "private": true,
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "glob": "14.0.4",
    "minimatch": "11.0.5"
  }
}
